{
  "runName": "http-smoke",
  "metadata": {
    "environment": "local-docker",
    "branch": "demo",
    "version": "demo",
    "seed": "demo"
  },
  "targets": [
    {
      "name": "local",
      "baseUrl": "http://127.0.0.1:5002",
      "tags": {
        "kind": "demo"
      }
    }
  ],
  "scenario": {
    "name": "http-smoke",
    "method": "GET",
    "path": "/health",
    "warmupSeconds": 0,
    "loadProfile": {
      "type": "inject",
      "ratePerSecond": 5,
      "durationSeconds": 5
    },
    "timeoutSeconds": 10,
    "expectedStatusCodes": [200],
    "thresholds": {
      "maxFailedRequests": 0,
      "maxP95Ms": 1000
    }
  }
}
