{
  "runName": "http-workflow-pack",
  "metadata": {
    "environment": "local-docker",
    "branch": "demo",
    "version": "demo",
    "seed": "workflow-demo"
  },
  "targets": [
    {
      "name": "local",
      "baseUrl": "http://127.0.0.1:5002",
      "tags": {
        "kind": "demo"
      }
    }
  ],
  "scenario": {
    "name": "demo-multi-step",
    "driver": "workflow",
    "stepName": "workflow",
    "warmupSeconds": 0,
    "loadProfile": {
      "type": "inject",
      "ratePerSecond": 5,
      "durationSeconds": 5
    },
    "timeoutSeconds": 10,
    "thresholds": {
      "maxFailedRequests": 0,
      "maxP95Ms": 1000
    }
  },
  "scenarioPack": {
    "assemblyPath": "demo-scenario-pack/bin/Debug/net10.0/ScenarioBench.DemoScenarioPack.dll",
    "workflow": "demo-multi-step",
    "properties": {
      "minTotalRequests": "1"
    }
  }
}
